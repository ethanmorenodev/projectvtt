<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Secretos de desarrollo fuera del repositorio (ADR-024):
         dotnet user-secrets set "ConnectionStrings:Default" "..." -->
    <UserSecretsId>projectvtt-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paquetes de contenido seed (PMB-P.4) y blueprints de creación
         (PMB-3.2): se copian al output y se importan de forma idempotente
         al arrancar. -->
    <Content Update="Content\Seed\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Characters\Blueprints\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
