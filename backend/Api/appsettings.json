{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "postgres"
  },
  "Auth": {
    "SessionMinutes": 720
  },
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 10
  },
  "Assets": {
    "RootPath": "",
    "MaxBytes": 10485760
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
