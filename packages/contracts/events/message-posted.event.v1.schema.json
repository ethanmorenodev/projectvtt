{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectvtt/events/message-posted.event.v1",
  "title": "MessagePosted (evento)",
  "description": "Evento emitido a todos los miembros de la campaña después de persistir un mensaje del chat de campaña. Aditivo a ADR-010 (Épica F, ver ADR-016). Sigue el envelope de ARCHITECTURE.md §7; sin aggregateVersion (sigue el precedente de inventory-updated).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "campaignId",
    "actorUserId",
    "occurredAt",
    "schemaVersion",
    "message"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento."
    },
    "campaignId": {
      "type": "string",
      "format": "uuid"
    },
    "actorUserId": {
      "type": "string",
      "format": "uuid",
      "description": "Usuario que envió el mensaje."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Marca temporal UTC del servidor."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Versión del esquema de este evento."
    },
    "message": { "$ref": "#/$defs/message" }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mensaje con el mismo shape que ChatMessageDto en el backend (backend/Api/Chat/Dtos.cs).",
      "required": [
        "id",
        "campaignId",
        "userId",
        "userName",
        "body",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "campaignId": { "type": "string", "format": "uuid" },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "Autor del mensaje (miembro de la campaña)."
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Nombre de usuario del autor, resuelto al leer (join con users)."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Texto del mensaje, recortado por el servidor."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
